{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run ui:build",
  "outputDirectory": "ui/dist",
  "functions": {
    "api/handler.mjs": {
      "includeFiles": "app-backend/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__api_route=:path*" },
    { "source": "/coach", "destination": "/index.html" },
    { "source": "/calendar", "destination": "/index.html" },
    { "source": "/week", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/annual-plan", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ]
}
