{
  "name": "open-triathlon-coach-app",
  "version": "1.0.0",
  "description": "Triathlon coaching app connected to Intervals.icu",
  "type": "module",
  "main": "app-backend/server.mjs",
  "scripts": {
    "build": "npm --prefix ui run build",
    "build:ui": "npm run ui:build",
    "start": "node app-backend/server.mjs",
    "dev": "npm --prefix ui run dev",
    "typecheck": "npm --prefix ui run build",
    "lint": "npm --prefix ui run lint",
    "format": "prettier --write app-backend/lib/*.mjs *.md",
    "format:check": "prettier --check app-backend/lib/*.mjs *.md",
    "test": "node --test app-backend/lib/*.test.mjs",
    "app:server": "node app-backend/server.mjs",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm ci --prefix ui --include=dev && npm --prefix ui run build"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.1"
  }
}
